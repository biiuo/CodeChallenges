# Example environment variables for the project

# Application
PORT=3000

# Database (Postgres)
# Format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://user:pass@db:5432/db?schema=public

# JWT secrets (required)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Redis (either REDIS_URL or REDIS_HOST/REDIS_PORT...)
REDIS_URL=redis://default:redispass@redis:6379/0
# or
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_DB=0
